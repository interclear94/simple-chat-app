# ==========================================
# 1. 의존성 패키지 (용량이 매우 크고 재설치 가능)
# ==========================================
node_modules/
.pnpm-store/
.yarn/

# ==========================================
# 2. 환경변수 및 암호화 키 (보안 위험, 절대로 커밋 금지)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 3. 빌드 결과물 (자동 생성되는 파일들)
# ==========================================
# Express (TypeScript 컴파일 결과물)
dist/
build/

# React (Vite / CRA 빌드 결과물)
dist/
build/
out/

# ==========================================
# 4. 사용자 업로드 파일 (multer 등으로 서버에 저장된 사진)
# ==========================================
# 백엔드의 이미지 저장 폴더 (실제 서비스 파일 제외)
uploads/
public/uploads/
!public/uploads/.gitkeep

# ==========================================
# 5. OS 및 IDE 설정 파일
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / WebStorm
.idea/

# ==========================================
# 6. 로그 및 기타 런타임 데이터
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache