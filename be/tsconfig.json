{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true, // 외부 라이브러리(sequelize) import 호환성 활성화
    "allowSyntheticDefaultImports": true, // default import 에러 방지지
    "rootDir": "./src",
    "outDir": "./dist",

    // For nodejs:
    "lib": ["esnext"],
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
