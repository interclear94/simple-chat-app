{
  "compilerOptions": {
    "target": "ES2022",

    /*
      CommonJS로 컴파일합니다.

      이 설정에서는 상대 경로 import에
      .js 확장자를 붙이지 않아도 됩니다.
    */
    "module": "CommonJS",

    /*
      NodeNext가 아니라 Node 방식으로 모듈을 찾습니다.

      NodeNext를 사용하면 TypeScript가
      실제 Node.js ESM 규칙을 따르기 때문에
      상대 경로에 .js를 요구할 수 있습니다.
    */

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /*
      CommonJS 환경에서 import/export를
      조금 더 자연스럽게 사용할 수 있도록 합니다.
    */
    "allowSyntheticDefaultImports": true
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
